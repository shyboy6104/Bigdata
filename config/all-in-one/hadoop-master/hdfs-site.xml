<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- ===============================================
Hadoop Master 节点 HDFS 配置文件
作用：定义 NameNode 元数据、服务地址、副本策略和教学接口
原理：NameNode 维护文件系统命名空间，DataNode 保存实际数据块
节点类型：Master 节点专用配置
版本说明：端口采用 Hadoop 3.1.3 约定，不使用 Hadoop 2.x 的 50010/50075
=============================================== -->
<configuration>
    <!-- ===============================================
    数据副本配置
    作用：指定每个 HDFS 数据块默认保存的副本数量
    原理：副本分布到不同 DataNode，以提高容错能力
    当前值：3，与三个 Worker/DataNode 对应
    =============================================== -->
    <property>
        <name>dfs.replication</name>
        <value>3</value>
        <description>三个 Worker 各保存一个数据副本</description>
    </property>

    <!-- ===============================================
    NameNode 元数据目录
    作用：保存 fsimage，即 HDFS 命名空间的持久化快照
    原理：NameNode 启动时读取该目录恢复目录树和文件元数据
    注意：这是 Master 本地持久化目录，不是 HDFS URI
    =============================================== -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file:///opt/hadoop/data/namenode</value>
        <description>NameNode 元数据目录</description>
    </property>

    <!-- ===============================================
    NameNode 检查点目录
    作用：保存合并 fsimage 与 edits 后生成的检查点
    原理：检查点可缩短 NameNode 重启时回放编辑日志的时间
    =============================================== -->
    <property>
        <name>dfs.namenode.checkpoint.dir</name>
        <value>file:///opt/hadoop/data/checkpoint</value>
        <description>NameNode 检查点目录</description>
    </property>

    <!-- ===============================================
    NameNode 编辑日志目录
    作用：记录文件创建、删除、重命名等命名空间变更
    原理：运行期操作先追加到 edits，再周期性合并到 fsimage
    =============================================== -->
    <property>
        <name>dfs.namenode.edits.dir</name>
        <value>file:///opt/hadoop/data/edits</value>
        <description>NameNode edits 目录</description>
    </property>

    <!-- ===============================================
    NameNode RPC 服务地址
    作用：为 HDFS 客户端和 DataNode 提供内部通信入口
    原理：容器通过 Docker DNS 将 master 解析到 Master 节点
    端口：9000，与 core-site.xml 中 fs.defaultFS 保持一致
    =============================================== -->
    <property>
        <name>dfs.namenode.rpc-address</name>
        <value>master:9000</value>
        <description>NameNode RPC 服务地址</description>
    </property>

    <!-- ===============================================
    NameNode Web UI 地址
    作用：提供 HDFS 状态、DataNode 列表和文件浏览页面
    原理：0.0.0.0 让服务监听容器全部网络接口
    端口：9870，是 Hadoop 3.x NameNode HTTP 端口
    =============================================== -->
    <property>
        <name>dfs.namenode.http-address</name>
        <value>0.0.0.0:9870</value>
        <description>NameNode Web UI 监听地址</description>
    </property>

    <!-- ===============================================
    HDFS 权限检查
    作用：控制 NameNode 是否校验 HDFS 用户和目录权限
    教学取值：false，减少本地实验中的用户映射干扰
    生产提示：生产环境通常应启用，并结合认证和权限规划
    =============================================== -->
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
        <description>教学环境关闭 HDFS 权限检查</description>
    </property>

    <!-- ===============================================
    WebHDFS REST 接口
    作用：允许通过 HTTP REST API 操作 HDFS 文件和目录
    原理：便于演示非 Java 客户端如何访问 HDFS
    =============================================== -->
    <property>
        <name>dfs.webhdfs.enabled</name>
        <value>true</value>
        <description>启用 WebHDFS 教学接口</description>
    </property>

    <!-- ===============================================
    WebHDFS CSRF 检查
    作用：控制 WebHDFS 是否启用跨站请求伪造防护
    教学取值：false，便于本地 REST 实验
    生产提示：暴露到不可信网络前应重新评估安全策略
    =============================================== -->
    <property>
        <name>dfs.webhdfs.rest-csrf.enabled</name>
        <value>false</value>
        <description>教学环境关闭 WebHDFS CSRF 检查</description>
    </property>

    <!-- ===============================================
    HDFS Balancer 带宽
    作用：限制每个 DataNode 数据均衡时使用的网络带宽
    原理：避免 Balancer 大量迁移数据影响正常读写
    当前值：10485760 字节/秒，即 10 MiB/s
    =============================================== -->
    <property>
        <name>dfs.datanode.balance.bandwidthPerSec</name>
        <value>10485760</value>
        <description>Balancer 每个 DataNode 使用 10 MiB/s</description>
    </property>
</configuration>
