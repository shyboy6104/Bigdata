<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- ===============================================
Hadoop Master 节点核心配置文件
作用：定义 Hadoop 文件系统入口和通用 I/O 参数
原理：所有 Hadoop 客户端先读取 core-site.xml，再通过 fs.defaultFS 定位 NameNode
节点类型：Master 节点；Worker 使用同名客户端参数连接 Master
说明：YARN 参数放在 yarn-site.xml，JVM 内存由 Compose 环境变量控制
=============================================== -->
<configuration>
    <!-- ===============================================
    HDFS 默认文件系统配置
    作用：定义无 scheme 路径默认访问的文件系统
    原理：客户端通过该 URI 定位 NameNode 的 RPC 服务
    重要性：hdfs dfs、MapReduce、Hive、Spark 等都会读取此入口
    =============================================== -->
    <property>
        <name>fs.defaultFS</name>
        <value>hdfs://master:9000</value>
        <description>五节点集群 NameNode RPC 地址</description>
    </property>

    <!-- ===============================================
    Hadoop 临时目录配置
    作用：保存 Hadoop 运行时产生的本地临时文件
    原理：未单独声明目录的组件会以此路径作为基础目录
    注意：该目录是容器内本地目录，不是 HDFS 路径
    =============================================== -->
    <property>
        <name>hadoop.tmp.dir</name>
        <value>/opt/hadoop/data/tmp</value>
        <description>Hadoop 本地临时目录</description>
    </property>

    <!-- ===============================================
    I/O 缓冲区配置
    作用：设置 Hadoop 文件读写的通用缓冲区大小
    原理：较大的缓冲区可减少底层 I/O 调用次数
    当前值：65536 字节，即 64 KiB
    =============================================== -->
    <property>
        <name>io.file.buffer.size</name>
        <value>65536</value>
        <description>I/O 缓冲区大小（64 KiB）</description>
    </property>
</configuration>
