<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<!-- ===============================================
Hadoop Worker 节点 HDFS 配置文件
作用：定义 DataNode 数据目录、传输端口和权限策略
原理：DataNode 保存实际数据块，并向 Master NameNode 注册和发送心跳
节点类型：worker-1、worker-2、worker-3
版本说明：使用 Hadoop 3.1.3 的 9866/9864/9867 端口
=============================================== -->
<configuration>
    <!-- ===============================================
    数据副本配置
    作用：为 Worker 上发起的 HDFS 写入提供默认副本数
    原理：NameNode 根据该值把数据块调度到不同 DataNode
    当前值：3，与三个 Worker/DataNode 对应
    =============================================== -->
    <property>
        <name>dfs.replication</name>
        <value>3</value>
        <description>三个 Worker 各保存一个数据副本</description>
    </property>

    <!-- ===============================================
    DataNode 数据目录
    作用：保存 HDFS 数据块和块校验信息
    原理：每个 Worker 使用自己的本地持久化目录
    注意：该目录不能与 NameNode 元数据目录混用
    =============================================== -->
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file:///opt/hadoop/data/datanode</value>
        <description>DataNode 数据目录</description>
    </property>

    <!-- ===============================================
    DataNode 数据传输地址
    作用：处理客户端和其他 DataNode 的数据块读写
    原理：0.0.0.0 监听容器全部接口，9866 为 Hadoop 3.x 数据端口
    =============================================== -->
    <property>
        <name>dfs.datanode.address</name>
        <value>0.0.0.0:9866</value>
        <description>Hadoop 3.x DataNode 数据传输端口</description>
    </property>

    <!-- ===============================================
    DataNode HTTP 服务地址
    作用：提供 DataNode 状态页面和部分数据传输辅助接口
    端口：9864，替代 Hadoop 2.x 常见的 50075
    =============================================== -->
    <property>
        <name>dfs.datanode.http.address</name>
        <value>0.0.0.0:9864</value>
        <description>Hadoop 3.x DataNode HTTP 端口</description>
    </property>

    <!-- ===============================================
    DataNode IPC 服务地址
    作用：提供 DataNode 进程间控制通信入口
    端口：9867，为 Hadoop 3.x 默认 IPC 端口
    =============================================== -->
    <property>
        <name>dfs.datanode.ipc.address</name>
        <value>0.0.0.0:9867</value>
        <description>Hadoop 3.x DataNode IPC 端口</description>
    </property>

    <!-- ===============================================
    HDFS 权限检查
    作用：与 Master 的权限策略保持一致
    教学取值：false，避免宿主机和容器用户不一致影响实验
    =============================================== -->
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
        <description>教学环境关闭 HDFS 权限检查</description>
    </property>
</configuration>
