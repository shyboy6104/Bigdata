# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows batch scripts must use CRLF so cmd.exe can parse IF/FOR blocks correctly.
*.bat text eol=crlf

# Explicitly declare shell scripts
*.sh text eol=lf

# Config files that must use LF
*.conf text eol=lf
*.cfg text eol=lf
*.properties text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf
*.env text eol=lf

# Docker files
Dockerfile text eol=lf
dockerfile.* text eol=lf
docker-compose*.yml text eol=lf

# Binary files
*.jar binary
*.tar.gz binary
*.zip binary
*.png binary
*.jpg binary
