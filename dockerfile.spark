FROM bigdata-base:latest

# 环境变量配置（包含版本信息）
ENV SPARK_VERSION=3.1.1
ENV SPARK_HOME=/opt/spark
ENV PATH=$SPARK_HOME/bin:$SPARK_HOME/sbin:$PATH

# PySpark 运行环境
# Spark 安装包已经自带 pyspark 与 py4j，这里只安装 Python 解释器，
# 并统一 Driver 与 Executor 使用 /usr/bin/python3，避免各节点解释器不一致。
ENV PYSPARK_PYTHON=/usr/bin/python3
ENV PYSPARK_DRIVER_PYTHON=/usr/bin/python3
ENV PYTHONPATH=$SPARK_HOME/python:$SPARK_HOME/python/lib/py4j-0.10.9-src.zip

# 基础镜像默认使用国内镜像；构建环境不可达时切回Ubuntu官方源。
# PySpark使用Spark自带模块，不需要额外执行pip install pyspark。
RUN sed -i 's/mirrors.aliyun.com/archive.ubuntu.com/g' /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=5 update && \
    apt-get -o Acquire::Retries=5 install -y --no-install-recommends python3 && \
    python3 --version && \
    rm -rf /var/lib/apt/lists/*

COPY module/spark-${SPARK_VERSION}-bin-hadoop3.2.tgz /tmp/
RUN tar -xzf /tmp/spark-${SPARK_VERSION}-bin-hadoop3.2.tgz && \
    mv spark-${SPARK_VERSION}-bin-hadoop3.2 ${SPARK_HOME} && \
    rm /tmp/spark-${SPARK_VERSION}-bin-hadoop3.2.tgz && \
    python3 -c "import pyspark; print('PySpark ' + pyspark.__version__)"

# MySQL Connector/J 5.1.49同时放入Master和Worker使用的Spark默认JAR目录。
# Spark Driver和Executor启动时都会扫描该目录，因此无需每次手工docker cp或
# 额外传递--jars。5.1.49对应的驱动类是com.mysql.jdbc.Driver。
COPY module/mysql-connector-java-5.1.49.jar ${SPARK_HOME}/jars/mysql-connector-java-5.1.49.jar
RUN test -s ${SPARK_HOME}/jars/mysql-connector-java-5.1.49.jar && \
    jar tf ${SPARK_HOME}/jars/mysql-connector-java-5.1.49.jar \
      | grep -qx 'com/mysql/jdbc/Driver.class'

# Spark原生start-all.sh/stop-all.sh通过SSH批量管理workers文件中的节点。
# 基础镜像已经生成root免密密钥；这里补充客户端策略，确保容器重建后不会因
# 主机指纹变化进入交互确认，同时使用BatchMode禁止退化为密码提示。
RUN mkdir -p ${SPARK_HOME}/logs /run/sshd /root/.ssh && \
    chmod 0700 /root/.ssh && \
    printf '%s\n' \
      'Host spark-worker1 spark-worker2' \
      '    BatchMode yes' \
      '    StrictHostKeyChecking no' \
      '    UserKnownHostsFile /dev/null' \
      '    ConnectTimeout 5' \
      '    LogLevel ERROR' \
      > /root/.ssh/config && \
    chmod 0600 /root/.ssh/config
# 复制配置文件和脚本
COPY config/ /config/
COPY scripts/spark-entrypoint.sh /scripts/spark-entrypoint.sh
RUN chmod +x /scripts/spark-entrypoint.sh

WORKDIR ${SPARK_HOME}

# 22用于Spark原生集群脚本的容器间SSH；其余端口分别用于RPC和Web UI。
EXPOSE 22 7077 8080 8081 4040 18080

ENTRYPOINT ["/scripts/spark-entrypoint.sh"]
